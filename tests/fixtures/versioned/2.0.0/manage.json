{
  "openapi": "3.0.3",
  "info": {"title": "Nexus Dashboard Manage v1", "version": "1.2.200", "description": "Fixture manage spec"},
  "servers": [{"url": "https://{cluster}/api/v1/manage"}],
  "tags": [{"name": "Widgets", "description": "Widget operations"}],
  "paths": {
    "/widgets": {
      "get": {"operationId": "listWidgets", "summary": "List widgets", "tags": ["Widgets"],
              "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Widget"}}}}}}},
      "post": {"operationId": "createWidgets", "summary": "Create widgets", "tags": ["Widgets"],
               "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Widget"}}}},
               "responses": {"200": {"description": "OK"}, "207": {"description": "Multi-Status"}}}
    },
    "/widgetActions/modify": {
      "post": {"operationId": "updateWidgets", "summary": "Update widgets", "tags": ["Widgets"],
               "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Widget"}, "minItems": 1, "maxItems": 10000}}}},
               "responses": {"207": {"description": "Multi-Status"}}}
    }
  },
  "components": {
    "schemas": {
      "Widget": {"type": "object", "description": "A widget", "properties": {"name": {"type": "string"}, "id": {"type": "integer"}, "color": {"type": "string"}}, "required": ["name"]},
      "Stable": {"type": "object", "properties": {"value": {"type": "string"}}},
      "NewThing": {"type": "object", "properties": {"shiny": {"type": "boolean"}}},
      "Shared": {"type": "object", "description": "manage flavour", "properties": {"x": {"type": "integer"}}}
    }
  }
}
